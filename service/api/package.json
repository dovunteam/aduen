{
  "name": "@aduen/case-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "prune:audit": "npm run build && node dist/pruneAudit.js",
    "prune:hosted-cases": "npm run build && node dist/pruneHostedCases.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:postgres": "npm run build && node --test test/postgres.integration.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
