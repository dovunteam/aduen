POSTGRES_DB=aduen
POSTGRES_MIGRATOR_USER=aduen_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-local-only-password
ADUEN_API_PASSWORD=replace-with-another-local-only-password
ADUEN_RETENTION_PASSWORD=replace-with-a-third-local-only-password
POSTGRES_PORT=54329
API_PORT=8080

# Percent-encode any reserved URL characters in the passwords above.
DATABASE_URL=postgres://aduen_api:replace-with-another-local-only-password@database:5432/aduen
DATABASE_URL_MIGRATOR=postgres://aduen_migrator:replace-with-a-local-only-password@database:5432/aduen
DATABASE_URL_MAINTENANCE=postgres://aduen_retention:replace-with-a-third-local-only-password@database:5432/aduen
AUDIT_RETENTION_DAYS=365
HOSTED_CASE_RETENTION_DAYS=
DATABASE_SSL=false

# Replace these example values with your OIDC provider's values before using authenticated routes.
AUTH_ISSUER=https://identity.example.invalid/
AUTH_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
AUTH_AUDIENCE=aduen-api
AUTH_MAX_TOKEN_AGE_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=
RATE_LIMIT_HMAC_KEY=
