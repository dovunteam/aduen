{
  "name": "Aduen-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:encoding": "node scripts/check-no-em-dashes.mjs",
    "check:docs": "node scripts/check-doc-index.mjs",
    "score:pilot": "node scripts/score-pilot.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:hosted": "playwright test e2e/hosted-account.spec.ts --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:firefox": "playwright test --project=firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/msa": "^1.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "oidc-client-ts": "3.5.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
